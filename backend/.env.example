# HerRise AI Backend Environment Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
JWT_SECRET=herrise_super_secure_jwt_secret_dev_2026
GROQ_API_KEY=gsk_your_groq_api_key_here

# MongoDB Database Connection
# Local: mongodb://localhost:27017/herrise_db
# Atlas: mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/herrise_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/herrise_db
MONGODB_DB_NAME=herrise_db

# HerMarket Digital Services
# Set a long, random value before using the admin dashboard. Never expose this in frontend env vars.
DIGITAL_SERVICES_ADMIN_TOKEN=replace-with-a-long-random-secret
# WhatsApp number in international format, digits only (example: 919876543210)
DIGITAL_SERVICES_WHATSAPP=

